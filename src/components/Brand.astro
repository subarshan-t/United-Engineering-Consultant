---
interface Props {
  dark?: boolean;
}

const { dark = false } = Astro.props;
---
<a class:list={['brand', { dark }]} href="/">
  <img src={dark ? '/images/logo-navy.png' : '/images/logo-white.png'} alt="United Engineering Consultants logo" width="50" height="51" />
  <span class="brand-txt"><span class="n1">UNITED ENGINEERING</span><span class="n2">CONSULTANT</span></span>
</a>
