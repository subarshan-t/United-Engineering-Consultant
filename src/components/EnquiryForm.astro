---
import Icon from './Icon.astro';
import { site } from '../data/site';

const projectTypes = [
  'New home',
  'Extension or addition',
  'Renovation',
  'Knockdown & Rebuild',
  'Secondary dwelling',
  'Development or subdivision',
  'Plans or engineering only',
  'Project management',
  'Something else',
];
---
<div class="form-card">
  <form class="enquiry" id="enquiry" action={site.formEndpoint || undefined} method="post" data-endpoint={site.formEndpoint} novalidate>
    <input type="hidden" name="access_key" value={site.formAccessKey} />
    <input type="hidden" name="subject" value={site.formSubject} />
    <input type="hidden" name="from_name" value={site.name} />
    <div class="fields">
      <label>NAME<input name="name" type="text" autocomplete="name" required /></label>
      <label>EMAIL<input name="email" type="email" autocomplete="email" required /></label>
    </div>
    <div class="fields">
      <label>PHONE<input name="phone" type="tel" autocomplete="tel" required /></label>
      <label>PROJECT ADDRESS / SUBURB<input name="address" type="text" autocomplete="street-address" /></label>
    </div>
    <label>PROJECT TYPE<span class="select">
      <select name="project_type">
        <option value="">Select a project type</option>
        {projectTypes.map((t) => <option>{t}</option>)}
      </select>
    </span></label>
    <label>MESSAGE<textarea name="message" rows="4"></textarea></label>
    <p class="form-note"><Icon name="upload" /><span>Have drawings or photos? Email them to <a href={`mailto:${site.email}`}>{site.email}</a> after sending this form.</span></p>
    <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <p class="form-error" id="form-error" hidden>Please fill in your name, email and phone.</p>
    <button class="btn btn-navy btn-lg btn-block" type="submit">Request a Quote <span class="arr" aria-hidden="true">→</span></button>
  </form>
  <div class="thanks" id="thanks" hidden>
    <span class="tick">✓</span>
    <h2 class="serif">Thank you.</h2>
    <p>We’ve received your enquiry and will be in touch {site.responseTime}.</p>
  </div>
</div>
